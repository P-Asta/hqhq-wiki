# SQLite database file. Relative paths resolve from the project root.
WIKI_DB_PATH=./wiki-data/wiki.db
WIKI_UPLOAD_ROOT=./wiki-data/uploads
WIKI_DEFAULT_LOCALE=en
WIKI_ADMIN_ROLES=admin,site-developer,wiki-admin

# Reading is public; every edit, upload and admin action requires a signed-in
# account. The server verifies each request's Firebase ID token against
# Google's published signing keys, so the Admin credentials below are
# OPTIONAL — sign-in and editing work without them. Setting them adds two
# things: the session-revocation check (otherwise a signed-out or disabled
# account stays valid until its token expires, up to an hour), and Firestore
# access that bypasses security rules (which the admin console's user search
# and ban write may otherwise be refused).

# Public Firebase web config. These values identify the High Quota HQ project.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCklz28QDpVHdagTruIxlPc5hdi-fj6QxE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=highquotahq214.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=highquotahq214
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=highquotahq214.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=224586017261
NEXT_PUBLIC_FIREBASE_APP_ID=1:224586017261:web:86d75e8878e42209a4dfe4

# Server-only Firebase Admin credentials — OPTIONAL (see the note at the top).
# Never prefix these with NEXT_PUBLIC_. Prefer GOOGLE_APPLICATION_CREDENTIALS
# in production when available.
FIREBASE_PROJECT_ID=highquotahq214
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Wiki Q&A agent (scripts/agent-server.ts, `yarn agent`). Paste your GLM
# Coding Plan (subscription) token from https://z.ai and it just works — the
# defaults below target the subscription endpoint and glm-5.3.
GLM_API_KEY=
# Subscription tokens ONLY work on the coding endpoint (default). For a
# pay-as-you-go API key use https://api.z.ai/api/paas/v4 instead; mainland
# keys use https://open.bigmodel.cn/api/coding/paas/v4 (or .../api/paas/v4).
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# glm-5.3 is the flagship; glm-4.7 is cheaper, glm-4.7-flash free (API only).
GLM_MODEL=glm-5.3
# Optional tuning: answer token cap (default 4096, max 131072), sampling
# temperature 0-1 (default 0.6; 0 is honored), reasoning depth for thinking
# models (none/minimal/low/medium/high/xhigh/max — default low for snappy
# Q&A; GLM-5.x always reasons), and the GLM-4.x reasoning toggle
# ("enabled"/"disabled", default disabled).
GLM_MAX_TOKENS=
GLM_TEMPERATURE=
GLM_REASONING_EFFORT=
GLM_THINKING=
# Where the agent's WebSocket server listens…
WIKI_AGENT_PORT=8788
WIKI_AGENT_HOST=127.0.0.1
# …and where the ask side panel (header "Ask the wiki" dock) connects to it
# (inlined into the client bundle).
NEXT_PUBLIC_WIKI_AGENT_WS_URL=ws://localhost:8788
# Browser origins allowed to open the socket (comma-separated; anti-CSWSH).
# Defaults to the next dev origins http://localhost:3000,http://127.0.0.1:3000.
WIKI_AGENT_ALLOWED_ORIGINS=
